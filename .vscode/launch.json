{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Test (xUnit)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "--filter",
        "FullyQualifiedName=booking.com_playwright_tests.Tests.LandingPage.test_opening_landing_page"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
